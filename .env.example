# Transport & Server Configuration
TIKTOK_MCP_TRANSPORT=http
TIKTOK_MCP_HOST=0.0.0.0
TIKTOK_MCP_PORT=8770
TIKTOK_MCP_WORK_DIR=/var/lib/tiktok-mcp

# Whisper Speech Recognition
TIKTOK_MCP_WHISPER_MODEL=large-v3-turbo
TIKTOK_MCP_WHISPER_DEVICE=cpu
TIKTOK_MCP_WHISPER_COMPUTE=int8

# Outbound Proxy (optional - e.g. http://127.0.0.1:10809 or socks5://127.0.0.1:10808)
TIKTOK_MCP_PROXY=

# TikTok Cookies (optional - path to Netscape cookies.txt or browser name)
TIKTOK_MCP_COOKIES_FILE=
TIKTOK_MCP_COOKIES_BROWSER=

# Media Publishing & Video Downloads (optional)
# Controls where publish_video uploads media so the AI model and users can access it.
# Mode can be 'local', 'http', or 'off' (default: off).
TIKTOK_MCP_UPLOAD_MODE=off

# Option A: Custom Domain (Self-hosted Nginx / Caddy)
# TIKTOK_MCP_LOCAL_DIR=/var/www/media
# TIKTOK_MCP_PUBLIC_BASE_URL=https://media.yourdomain.com

# Option B: GitHub Pages (Free static hosting)
# TIKTOK_MCP_LOCAL_DIR=/path/to/your-repo/docs/media
# TIKTOK_MCP_PUBLIC_BASE_URL=https://<username>.github.io/<repo>/media

# Option C: Remote HTTP Upload Service
# TIKTOK_MCP_UPLOAD_URL=https://media.yourdomain.com/api/upload
# TIKTOK_MCP_UPLOAD_TOKEN=your_secret_upload_token
