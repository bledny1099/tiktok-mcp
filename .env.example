# Transport & Server Configuration
TIKTOK_MCP_TRANSPORT=http
TIKTOK_MCP_HOST=0.0.0.0
TIKTOK_MCP_PORT=8770
TIKTOK_MCP_WORK_DIR=/var/lib/tiktok-mcp

# Whisper Speech Recognition
TIKTOK_MCP_WHISPER_MODEL=large-v3-turbo
TIKTOK_MCP_WHISPER_DEVICE=cpu
TIKTOK_MCP_WHISPER_COMPUTE=int8

# Outbound Proxy (optional - e.g. http://127.0.0.1:10809 or socks5://127.0.0.1:10808)
TIKTOK_MCP_PROXY=

# TikTok Cookies (optional - path to Netscape cookies.txt or browser name)
TIKTOK_MCP_COOKIES_FILE=
TIKTOK_MCP_COOKIES_BROWSER=

# Media Publishing Configuration (optional)
TIKTOK_MCP_UPLOAD_MODE=off
TIKTOK_MCP_LOCAL_DIR=
TIKTOK_MCP_PUBLIC_BASE_URL=
TIKTOK_MCP_UPLOAD_URL=
TIKTOK_MCP_UPLOAD_TOKEN=
